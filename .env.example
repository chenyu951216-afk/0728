# Service
PORT=8080
TZ=Asia/Taipei
LOG_LEVEL=INFO
DATABASE_PATH=/data/eth_adaptive.db

# Live scan / historical learning
SCAN_SECONDS=60
LEARNING_SLEEP_SECONDS=3
LEARNING_BACKFILL_PAGES_PER_TICK=5
LEARNING_START_TS=1577836800
# Legacy compatibility only. v5/v6 do NOT use a fixed 60% live gate;
# each LONG/SHORT Champion learns its own threshold in chronological calibration.
SIGNAL_MIN_PROBABILITY=0.60
POST_EXIT_BARS=96

# Risk sizing: 0.02 = 2% of configured account equity at the initial stop
RISK_PER_TRADE=0.02

# v6 exact execution-policy OOS validation.
# Defaults are deliberately conservative and may be left unchanged in Zeabur.
# ALL_IN_COST_BPS is the estimated full-position round-trip fees/slippage used
# inside execution OOS; MIN_STOP_PCT prevents unrealistically tiny stops whose
# friction would dominate the entire R unit.
EXECUTION_ALL_IN_COST_BPS=8.0
EXECUTION_MIN_STOP_PCT=0.0020
EXECUTION_MAX_HOLD_BARS=32

# Optional aggregated historical derivatives enrichment.
# If absent, the engine keeps explicit missingness flags and uses exchange-native
# public OI/funding fallbacks where available; it never invents the missing fields.
COINGLASS_API_KEY=

# Discord notification + command channel
# v6 retries webhook first and falls back to Bot/channel for outgoing alerts.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
