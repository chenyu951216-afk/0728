# Service
PORT=8080
TZ=Asia/Taipei
LOG_LEVEL=INFO
DATABASE_PATH=/data/eth_adaptive.db

# Live scan / historical learning
SCAN_SECONDS=60
LEARNING_SLEEP_SECONDS=3
LEARNING_BACKFILL_PAGES_PER_TICK=5
LEARNING_START_TS=1577836800
# Legacy compatibility only. Evolution mode does NOT use a single fixed 60% live gate;
# each LONG/SHORT Signal Champion learns its own chronological threshold.
SIGNAL_MIN_PROBABILITY=0.60
POST_EXIT_BARS=96

# Risk sizing: 0.02 = 2% of configured account equity at the initial stop.
RISK_PER_TRADE=0.02

# Live lifecycle monitoring and anti-churn re-entry guard.
POSITION_MONITOR_SECONDS=5
REENTRY_COOLDOWN_BARS=6

# Point-in-time execution-policy validation.
EXECUTION_ALL_IN_COST_BPS=8.0
EXECUTION_MIN_STOP_PCT=0.0020
EXECUTION_MAX_HOLD_BARS=32
EXECUTION_MIN_AUDIT_FILLS=50
EXECUTION_WF_MIN_OPPORTUNITIES=126
EXECUTION_WF_MIN_FOLDS=3
EXECUTION_WF_MIN_FOLD_FILLS=8
EXECUTION_WF_TOP_POLICIES=6

# Strict Replay 8.0.3.
# A historical decision at T may use only candles whose CLOSE was available by T.
# 2 = one decision every 30 minutes. Set 1 for every 15m decision only if the
# persistent-volume and CPU budget can support the larger history.
STRICT_REPLAY_STRIDE_BARS=2
# Conservative availability delay for aggregated historical OI/liquidation/orderbook
# intervals. Funding event timestamps are not delayed by this guard.
STRICT_DERIVATIVE_SAFETY_LAG_SECONDS=14400
# Optional CoinGlass liquidation/orderbook enrichment may not deadlock the entire replay.
# After this many identical persistent provider rejections, that enrichment family is
# held explicitly unavailable for this replay. Transient timeout/429/5xx errors never
# trigger automatic exclusion. OI remains the core readiness metric unless the whole
# CoinGlass key is explicitly rejected by auth/plan, in which case native fallback is used.
STRICT_CG_ENRICHMENT_DISABLE_AFTER=2
# New paper signals may only be created shortly after the newest closed 15m candle.
# If an API outage recovers later, the system waits for the next close instead of
# synthesizing a stale historical decision at the current ticker price.
STRICT_LIVE_DECISION_MAX_AGE_SECONDS=120

# Full-span model training. The DB may contain more rows, but training never silently
# keeps only the newest tail. Older 2020->present history is deterministically
# time-decimated while the newest block remains dense.
STRICT_MODEL_MAX_ROWS=60000
STRICT_MODEL_RECENT_ROWS=20000

# Execution mutation happens only on DEV. Validation chooses among final elites;
# untouched walk-forward audit can never feed mutations back into the same fold.
EXECUTION_EVOLUTION_GENERATIONS=5
EXECUTION_EVOLUTION_ELITES=8
EXECUTION_EVOLUTION_CHILDREN_PER_ELITE=4

# Guarded continuous evolution.
# Signal Genome candidates compete only inside each historical train/calibration fold.
# New live trades never directly become Signal labels. After this many newly closed
# live/paper trades, deployment evidence triggers a fresh Execution audit; untouched
# audit rules still decide promotion.
EVOLUTION_LIVE_REAUDIT_BATCH=5
# Initial broad Execution candidates before DEV-only multi-generation mutation.
EVOLUTION_EXECUTION_CANDIDATES=96

# Persistent-storage safety. Production should keep this true.
REQUIRE_PERSISTENT_STORAGE=true

# Optional aggregated historical derivatives enrichment.
COINGLASS_API_KEY=

# Discord notification + command channel.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
