# Service
PORT=8080
TZ=Asia/Taipei
LOG_LEVEL=INFO
DATABASE_PATH=/data/eth_adaptive.db

# Live scan / historical learning
SCAN_SECONDS=60
LEARNING_SLEEP_SECONDS=3
LEARNING_BACKFILL_PAGES_PER_TICK=5
LEARNING_START_TS=1577836800
# Legacy compatibility only. v7 does NOT use a fixed 60% live gate;
# each LONG/SHORT Signal Champion learns its own chronological threshold.
SIGNAL_MIN_PROBABILITY=0.60
POST_EXIT_BARS=96

# Risk sizing: 0.02 = 2% of configured account equity at the initial stop.
RISK_PER_TRADE=0.02

# v7 live lifecycle monitoring and anti-churn re-entry guard.
# POSITION_MONITOR_SECONDS controls ordered public-trade monitoring, independent
# of the slower full-market scan. REENTRY_COOLDOWN_BARS is measured in 15m bars;
# a new BOS/sweep/regime reset is still required after the time cooldown expires.
POSITION_MONITOR_SECONDS=5
REENTRY_COOLDOWN_BARS=6

# v7 point-in-time execution-policy validation.
# Costs are deducted inside the historical execution audit. MIN_STOP_PCT is only
# a floor; multi-timeframe 15m/30m/1h structure may place the stop farther away.
EXECUTION_ALL_IN_COST_BPS=8.0
EXECUTION_MIN_STOP_PCT=0.0020
EXECUTION_MAX_HOLD_BARS=32
EXECUTION_MIN_AUDIT_FILLS=50

# Optional aggregated historical derivatives enrichment.
# If absent, the engine keeps explicit missingness flags and uses exchange-native
# public OI/funding fallbacks where available; it never invents missing fields.
COINGLASS_API_KEY=

# Discord notification + command channel.
# Outgoing alerts retry webhook first and fall back to Bot/channel.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
