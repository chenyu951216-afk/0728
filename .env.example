# Service
PORT=8080
TZ=Asia/Taipei
LOG_LEVEL=INFO
DATABASE_PATH=/data/eth_adaptive.db
REQUIRE_PERSISTENT_STORAGE=true

# Live scan / historical replay
SCAN_SECONDS=60
LEARNING_SLEEP_SECONDS=3
LEARNING_BACKFILL_PAGES_PER_TICK=5
# Exact Asia/Taipei 2020-01-01 00:00. server_entry_v27 enforces this for V35+.
LEARNING_START_TS=1577808000

# Autonomous research window. Decisions stop after all of 2026-08-01.
# Raw data after this date may be used only to resolve already-frozen trade outcomes.
AUTONOMOUS_RESEARCH_START_TS=1577808000
AUTONOMOUS_RESEARCH_END_TS=1785600000
AUTONOMOUS_SETTLEMENT_END_TS=1786723200
AUTONOMOUS_POPULATION=48
AUTONOMOUS_GENERATIONS=8
AUTONOMOUS_ELITES=10
AUTONOMOUS_FINALISTS=20
AUTONOMOUS_MAX_CHAMPIONS=10
AUTONOMOUS_FINAL_HOLDOUT_PCT=0.18
AUTONOMOUS_MIN_OOS_FILLS=60
AUTONOMOUS_MIN_OOS_PF=1.25
AUTONOMOUS_MIN_OOS_EV_R=0.08
AUTONOMOUS_MAX_OOS_DD_R=12.0
AUTONOMOUS_MIN_WF_STABILITY=0.60
AUTONOMOUS_MIN_PROFITABLE_FOLDS=0.66
AUTONOMOUS_MIN_WORST_FOLD_EV=-0.08
AUTONOMOUS_MIN_BOOTSTRAP_CI05=0.0
AUTONOMOUS_PAPER_NOTIONAL_USDT=20000
AUTONOMOUS_LIVE_MIN_PREDICTED_EV_R=0.04
AUTONOMOUS_LIVE_MAX_OOD_FRACTION=0.35
AUTONOMOUS_MEMORY_SOFT_RATIO=0.70
AUTONOMOUS_MEMORY_HARD_RATIO=0.86

# V43 unified performance/resource authority.
# These controls only change execution efficiency/resource pressure. They do NOT
# reduce history/features/population/generations/OOS rules or alter no-lookahead.
AUTONOMOUS_V43_MEMORY_SOFT_RATIO=0.72
AUTONOMOUS_V43_MEMORY_HARD_RATIO=0.84
AUTONOMOUS_V43_MEMORY_EMERGENCY_RATIO=0.90
AUTONOMOUS_V43_DB_PAGECACHE_DROP_RATIO=0.70
AUTONOMOUS_V43_MMAP_DROP_RATIO=0.82
AUTONOMOUS_V43_FAST_SIM_PARITY_TRADES=48
AUTONOMOUS_V43_MIN_YIELD_MS=2
AUTONOMOUS_V43_MAX_YIELD_MS=160
AUTONOMOUS_V43_GC_EVERY=12

# Freeze the initial raw-data horizon and finish every required timeframe before
# causal replay. Replay stays at 0% while this contract is incomplete.
CAUSAL_PRICE_MIN_COVERAGE_PCT=100.0
CAUSAL_PRICE_MAX_MISSING_BARS=0
CAUSAL_PRICE_START_TOLERANCE_BARS=2
CAUSAL_PRICE_TAIL_TOLERANCE_BARS=3
POST_EXIT_BARS=96

# Paper execution: fixed ETH notional. Max leverage changes margin requirement, not
# the PnL of a fixed 20,000-USDT notional position.
EXECUTION_ALL_IN_COST_BPS=8.0
POSITION_MONITOR_SECONDS=5

# Strict replay / no-lookahead
# Every 15m decision is replayed; feature values must have existed at that timestamp.
# Future 5m bars are revealed sequentially only after the complete simulated package
# (direction, state gate, entry, stop, targets and management) is frozen.
STRICT_REPLAY_STRIDE_BARS=1
STRICT_DERIVATIVE_SAFETY_LAG_SECONDS=14400
STRICT_LIVE_DECISION_MAX_AGE_SECONDS=120
STRICT_REPLAY_BATCH_DECISIONS=2000
SQLITE_BUSY_TIMEOUT_MS=20000

# Provider/data resilience
STRICT_CORE_DERIVATIVE_PAGES_PER_TICK=4
STRICT_SOURCE_DISABLE_AFTER=2
STRICT_DISABLED_SOURCE_PROBE_SECONDS=3600
STRICT_CG_ENRICHMENT_DISABLE_AFTER=2
STRICT_GAP_REPAIR_ROUNDS=2
STRICT_MAX_QUARANTINED_GAPS=24
STRICT_MODEL_MAX_ROWS=60000
STRICT_MODEL_RECENT_ROWS=20000

# The older Signal/Execution knobs remain for compatibility with the replay/data
# stack but are not the autonomous direct-R strategy objective.
SIGNAL_MIN_PROBABILITY=0.60
EXECUTION_MIN_STOP_PCT=0.0020
EXECUTION_MIN_STOP_COST_MULTIPLE=5.0
EXECUTION_MAX_HOLD_BARS=32
EXECUTION_MIN_AUDIT_FILLS=50
EXECUTION_MIN_AUDIT_PF=1.30
EXECUTION_MIN_AUDIT_EV_R=0.10
EXECUTION_WF_MIN_OPPORTUNITIES=126
EXECUTION_WF_MIN_FOLDS=3
EXECUTION_WF_MIN_FOLD_FILLS=8
EXECUTION_WF_TOP_POLICIES=6
EXECUTION_EVOLUTION_GENERATIONS=5
EXECUTION_EVOLUTION_ELITES=8
EXECUTION_EVOLUTION_CHILDREN_PER_ELITE=4
EVOLUTION_LIVE_REAUDIT_BATCH=5
EVOLUTION_EXECUTION_CANDIDATES=96
SIGNAL_EVOLUTION_GENERATIONS=7
SIGNAL_EVOLUTION_POPULATION=36
SIGNAL_EVOLUTION_ELITES=6
SIGNAL_FINAL_HOLDOUT_PCT=0.20
SIGNAL_MIN_HOLDOUT_SELECTED=60
SIGNAL_MIN_UNTOUCHED_HOLDOUT=320
SIGNAL_MIN_OOS_PF=1.25
SIGNAL_MIN_OOS_EV_R=0.06

# Optional aggregated historical derivatives. Exchange-native sources are fetched
# independently. Never fill historical gaps with present-day values.
COINGLASS_API_KEY=
COINGLASS_PLAN=STANDARD
COINGLASS_HEATMAP_TTL_SECONDS=600
COINGLASS_HEATMAP_STALE_SECONDS=1200
COINGLASS_HEATMAP_STOP_BAND_R=0.12

DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
