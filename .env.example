# Service
PORT=8080
TZ=Asia/Taipei
LOG_LEVEL=INFO
DATABASE_PATH=/data/eth_adaptive.db

# Live scan / historical learning
SCAN_SECONDS=60
LEARNING_SLEEP_SECONDS=3
LEARNING_BACKFILL_PAGES_PER_TICK=5
LEARNING_START_TS=1577836800
SIGNAL_MIN_PROBABILITY=0.60
POST_EXIT_BARS=96

RISK_PER_TRADE=0.02
POSITION_MONITOR_SECONDS=5
REENTRY_COOLDOWN_BARS=6

EXECUTION_ALL_IN_COST_BPS=8.0
EXECUTION_MIN_STOP_PCT=0.0020
EXECUTION_MAX_HOLD_BARS=32
EXECUTION_MIN_AUDIT_FILLS=50
EXECUTION_WF_MIN_OPPORTUNITIES=126
EXECUTION_WF_MIN_FOLDS=3
EXECUTION_WF_MIN_FOLD_FILLS=8
EXECUTION_WF_TOP_POLICIES=6

# Strict Replay 8.0.4
STRICT_REPLAY_STRIDE_BARS=2
STRICT_DERIVATIVE_SAFETY_LAG_SECONDS=14400
STRICT_LIVE_DECISION_MAX_AGE_SECONDS=120

# Multi-source historical derivatives. Deterministic provider rejection may disable
# only that source for the current replay generation; timeout/429/5xx always retry.
STRICT_SOURCE_DISABLE_AFTER=2
STRICT_DISABLED_SOURCE_PROBE_SECONDS=3600
STRICT_CG_ENRICHMENT_DISABLE_AFTER=2

# Full-span model training
STRICT_MODEL_MAX_ROWS=60000
STRICT_MODEL_RECENT_ROWS=20000

# DEV-only execution evolution
EXECUTION_EVOLUTION_GENERATIONS=5
EXECUTION_EVOLUTION_ELITES=8
EXECUTION_EVOLUTION_CHILDREN_PER_ELITE=4
EVOLUTION_LIVE_REAUDIT_BATCH=5
EVOLUTION_EXECUTION_CANDIDATES=96

REQUIRE_PERSISTENT_STORAGE=true

# Optional aggregated historical derivatives. If unavailable, Gate/Bybit/Binance
# exchange-native history is still fetched where historically supported.
COINGLASS_API_KEY=

DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
