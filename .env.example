# Service
PORT=8080
TZ=Asia/Taipei
LOG_LEVEL=INFO
DATABASE_PATH=/data/eth_adaptive.db

# Live scan / historical learning
SCAN_SECONDS=60
LEARNING_SLEEP_SECONDS=3
LEARNING_BACKFILL_PAGES_PER_TICK=5
LEARNING_START_TS=1577836800
SIGNAL_MIN_PROBABILITY=0.60
POST_EXIT_BARS=96

# Risk sizing: 0.02 = 2% of configured account equity at the initial stop
RISK_PER_TRADE=0.02

# Optional aggregated historical derivatives enrichment.
# If absent, the engine keeps explicit missingness flags and uses exchange-native
# public OI/funding fallbacks where available; it never invents the missing fields.
COINGLASS_API_KEY=

# Optional Discord notification delivery
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
