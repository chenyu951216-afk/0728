# Service
PORT=8080
TZ=Asia/Taipei
LOG_LEVEL=INFO
DATABASE_PATH=/data/eth_adaptive.db

# Live scan / historical learning
SCAN_SECONDS=60
LEARNING_SLEEP_SECONDS=3
LEARNING_BACKFILL_PAGES_PER_TICK=5
LEARNING_START_TS=1577836800
# Legacy compatibility only. Evolution mode does NOT use a single fixed 60% live gate;
# each LONG/SHORT Signal Champion learns its own chronological threshold.
SIGNAL_MIN_PROBABILITY=0.60
POST_EXIT_BARS=96

# Risk sizing: 0.02 = 2% of configured account equity at the initial stop.
RISK_PER_TRADE=0.02

# Live lifecycle monitoring and anti-churn re-entry guard.
POSITION_MONITOR_SECONDS=5
REENTRY_COOLDOWN_BARS=6

# Point-in-time execution-policy validation.
EXECUTION_ALL_IN_COST_BPS=8.0
EXECUTION_MIN_STOP_PCT=0.0020
EXECUTION_MAX_HOLD_BARS=32
EXECUTION_MIN_AUDIT_FILLS=50

# Guarded continuous evolution.
# Signal Genome candidates are built into the code and compete only inside each
# historical train/calibration fold. New live trades never directly become Signal
# labels. After this many newly closed live/paper trades, their deployment evidence
# triggers a fresh Execution audit; untouched audit rules still decide promotion.
EVOLUTION_LIVE_REAUDIT_BATCH=5
# Number of deterministic continuous-style Execution candidates added per strategy.
# Higher values search more parameter combinations but cost more CPU. 96 is the default.
EVOLUTION_EXECUTION_CANDIDATES=96

# Optional aggregated historical derivatives enrichment.
COINGLASS_API_KEY=

# Discord notification + command channel.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
